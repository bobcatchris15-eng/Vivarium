; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Vivarium"
config/description="Digital Desktop Vivarium"
config/version="0.1.3"
run/main_scene="res://Main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="Vivarium"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
boot_splash/bg_color=Color(0.06, 0.09, 0.12, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/energy_saving/keep_screen_on=false
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Vivarium"

[rendering]

lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=5
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=5
reflections/reflection_atlas/reflection_size=512
environment/ssao/quality=3
environment/ssao/half_size=false
environment/ssil/quality=3
environment/ssil/half_size=false
environment/volumetric_fog/volume_size=128
environment/volumetric_fog/volume_depth=128
limits/cluster_builder/max_clustered_elements=4096
environment/defaults/default_clear_color=Color(0.55, 0.72, 0.86, 1)
anti_aliasing/quality/use_taa=true
lights_and_shadows/positional_shadow/atlas_size=8192
environment/sdfgi/probe_ray_count=4
environment/sdfgi/frames_to_converge=1
