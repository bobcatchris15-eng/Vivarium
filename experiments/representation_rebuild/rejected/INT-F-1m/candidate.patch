+                plant.Bend = new Vector3(.2f, 0, 0); plant.Target = new Vector3(.1f, 0, 0);
+                plant.Applied = new Transform3D(new Basis(Vector3.Forward, .2f) * plant.Base.Basis, plant.Base.Origin);
